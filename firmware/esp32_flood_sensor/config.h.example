// Copier ce fichier en config.h et renseigner les valeurs ci-dessous.
// Ne PAS committer config.h (clés sensibles).

#pragma once

#define WIFI_SSID       "VotreReseauWiFi"
#define WIFI_PASSWORD   "VotreMotDePasse"

// URL complète de la Cloud Function HTTPS, ex :
// https://europe-west1-alerte-douala.cloudfunctions.net/ingestSensorReading
#define INGEST_URL      "https://REGION-PROJECT.cloudfunctions.net/ingestSensorReading"

// Clé API définie côté serveur via:
//   firebase functions:secrets:set SENSOR_API_KEY
#define API_KEY         "secret-shared-with-cloud-function"

// Identifiant unique du dispositif. Doit correspondre au champ deviceId
// du document Firestore sensors/<id>.
#define DEVICE_ID       "ESP32-AKWA-001"
