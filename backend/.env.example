PORT=4000
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
# Une ou plusieurs origines séparées par des virgules. '*' autorisé comme wildcard
# (utile pour les URLs de preview Vercel, ex: https://*.vercel.app).
CORS_ORIGIN=http://localhost:5173
SENSOR_API_KEY=change-me-shared-secret-with-firmware

# Optionnel : chemin vers un volume persistant pour la base JSON (ex: sur Koyeb,
# le point de montage d'un Volume). Par défaut : backend/data (non persistant
# si le système de fichiers du conteneur est éphémère).
# DB_DIR=/data

# Web Push (notifications navigateur, même app fermée).
# Génération : node -e "const w=require('web-push'); console.log(w.generateVAPIDKeys())"
# La publique est exposée au frontend, la privée DOIT rester secrète côté serveur.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@exemple.com
